{
  "name": "@w8tcha/holdon.js",
  "type": "module",
  "version": "1.0.0",
  "description": "holdon is a tiny JS library to create an overlay dinamically with Javascript to prevent the access to the user interface.",
  "main": "dist/holdon.js",
  "types": "./dist/aholdon.d.ts",
  "exports": {
    "import": "./dist/holdon.js",
    "require": "./dist/holdon.umd.cjs"
  },
  "scripts": {
    "update-deps": "set npm_config_allow_scripts=&& npm-check -y",
    "test": "vitest",
    "dev": "vite",
    "build": "tsc && vite build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/w8tcha/holdon.js"
  },
  "keywords": [
    "loading"
  ],
  "author": "sdkcarlos",
  "license": "MIT",
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "sass": "^1.108.1"
  },
  "dependencies": {
    "vite": "^8.3.6",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
